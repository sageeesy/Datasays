    "allowed_dimensions": ["plan", "region", "customer_segment", "acquisition_channel"],
    "caveats": ["Reactivations should not be counted as new business unless policy says otherwise."],
    "source": "ChartMogul MRR movement methodology"
  },
  {
    "id": "saas.logo_churn_rate",
    "domain": "saas",
    "name": "Customer Churn Rate",
    "aliases": ["logo churn", "customer churn", "customer churn rate", "客户流失率", "账户流失率"],
    "description": "Share of starting paying accounts that churn during the period.",
    "formula": "churned_starting_accounts / starting_paying_accounts",
    "entity": "account",
    "grain": "period",
    "required_concepts": ["account_id", "subscription_status", "subscription_time"],
    "time_concept": "subscription_time",
    "default_filters": ["Use accounts active at the start of the period as denominator."],
    "allowed_dimensions": ["plan", "region", "customer_segment"],
    "caveats": ["Customer churn and revenue churn are not interchangeable."],
    "source": "ChartMogul SaaS Metrics Library"
  },
  {
    "id": "saas.revenue_churn_rate",
    "domain": "saas",
    "name": "Gross Revenue Churn Rate",
    "aliases": ["revenue churn", "MRR churn", "gross MRR churn", "收入流失率", "MRR流失率"],
    "description": "Recurring revenue lost to churn and contraction as a share of starting MRR.",
