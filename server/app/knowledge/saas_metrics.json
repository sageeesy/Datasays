    "required_concepts": ["mrr_movement", "movement_type", "movement_time"],
    "time_concept": "movement_time",
    "default_filters": ["Exclude new business, expansion, and reactivation."],
    "allowed_dimensions": ["plan", "region", "customer_segment"],
    "caveats": ["GRR should not exceed 100 percent under the standard definition."],
    "source": "ChartMogul SaaS Metrics Library"
  },
  {
