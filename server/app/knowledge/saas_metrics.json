    "description": "Annualized recurring revenue run rate.",
    "formula": "MRR * 12",
    "entity": "subscription",
    "grain": "year_run_rate",
    "required_concepts": ["recurring_amount", "billing_interval"],
    "time_concept": "subscription_time",
    "default_filters": ["Exclude one-time charges."],
    "allowed_dimensions": ["plan", "region", "customer_segment"],
    "caveats": ["ARR is a run-rate metric, not recognized annual revenue."],
    "source": "ChartMogul SaaS Metrics Library"
  },
  {
    "id": "saas.arpa",
    "domain": "saas",
