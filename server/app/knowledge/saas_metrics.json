    "grain": "snapshot",
    "required_concepts": ["account_id", "subscription_status"],
    "time_concept": "subscription_time",
    "default_filters": ["Define treatment of trials and past-due subscriptions."],
    "allowed_dimensions": ["plan", "region", "customer_segment"],
    "caveats": ["Use a point-in-time snapshot rather than period event counts."],
    "source": "ChartMogul subscription analytics methodology"
  },
  {
