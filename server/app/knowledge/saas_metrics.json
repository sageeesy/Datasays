[
  {
    "id": "saas.mrr",
    "domain": "saas",
    "name": "Monthly Recurring Revenue",
    "aliases": ["MRR", "monthly recurring revenue", "月度经常性收入", "月经常性收入"],
    "description": "Normalized recurring subscription revenue for one month.",
    "formula": "sum(normalized_monthly_subscription_amount)",
    "entity": "subscription",
    "grain": "month",
    "required_concepts": ["subscription_id", "recurring_amount", "billing_interval"],
    "time_concept": "subscription_time",
    "default_filters": ["Exclude one-time charges."],
    "allowed_dimensions": ["plan", "region", "customer_segment", "acquisition_channel"],
    "caveats": ["Annual and multi-month contracts must be normalized to monthly value."],
    "source": "ChartMogul SaaS Metrics Library"
  },
  {
    "id": "saas.arr",
    "domain": "saas",
    "name": "Annual Recurring Revenue",
