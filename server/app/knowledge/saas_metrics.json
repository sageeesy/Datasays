    "required_concepts": ["mrr_movement", "movement_type", "movement_time"],
    "time_concept": "movement_time",
    "default_filters": ["Exclude expansion and new business from the numerator."],
    "allowed_dimensions": ["plan", "region", "customer_segment"],
    "caveats": ["State whether contraction is included."],
    "source": "ChartMogul SaaS Metrics Cheat Sheet"
  },
  {
    "id": "saas.grr",
