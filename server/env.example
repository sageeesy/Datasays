# Server Configuration
PORT=8000
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# LLM Configuration (OpenRouter API)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=qwen/qwen3.6-flash

# Python Execution (Docker)
USE_DOCKER=true
DOCKER_IMAGE=datasays-python-sandbox
SANDBOX_TIMEOUT=30
SANDBOX_WORK_DIR=/tmp/datasays-sandbox
CODE_REPAIR_ATTEMPTS=2
DATASAYS_DB_PATH=./data/datasays.db

# Development-only fallback: direct execution is not safe for public use.
# PYTHON_PATH=python3

# CORS Configuration (optional)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://another-domain.com
# ALLOW_ALL_ORIGINS=false
