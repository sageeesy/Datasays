    { "id": "sse", "from": "query", "to": "web", "y": 568, "label": "SSE result envelope", "variant": "return" },
    { "id": "render", "from": "web", "to": "analyst", "y": 596, "label": "呈现 answer、KPI、chart、Evidence 与 Trace", "variant": "return" }
