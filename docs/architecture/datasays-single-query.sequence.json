    { "id": "query", "type": "backend", "label": "Query API", "sublabel": "FastAPI + SSE" },
    { "id": "agent", "type": "backend", "label": "Agent Graph", "sublabel": "LangGraph state" },
    { "id": "llm", "type": "cloud", "label": "LLM", "sublabel": "OpenRouter API" },
    { "id": "sandbox", "type": "security", "label": "Sandbox", "sublabel": "Docker / Python" },
    { "id": "gates", "type": "backend", "label": "Checks", "sublabel": "deterministic gates" },
    { "id": "state", "type": "database", "label": "Local State", "sublabel": "files + SQLite" }
